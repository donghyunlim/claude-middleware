c6d9997`)와 `README.md`는 변경하지 않았고, 작업 트리도 깨끗한 상태입니다.\n\nreflog를 비웠기 때문에 저장소에는 이제 `HEAD` 이동 기록이 남아 있지 않습니다.", "ttft_ms": 3753, "type": "result", "duration_ms": 23239, "uuid": "6922a5d1-c185-4319-bc78-71431d1b7f20", "ttft_stream_ms": 2055, "time_to_request_ms": 93, "time_to_request_phases_ms": {"other": 5, "system_prompt": 10, "resume_other": 0, "process_user_input": 1, "input_command": 20, "input_hooks": 1, "conversation_append": 0, "transcript_persist": 7, "tool_pool_refresh": 2, "init_message": 4, "init_frame_send": 2, "engine_pickup": 1, "loop_entry": 2, "message_prep": 1, "model_config_wait": 2, "autocompact": 2, "request_announcements": 6, "query_setup": 1, "model_gates": 0, "tool_schema_build": 17, "message_normalization": 2, "client_creation": 3, "request_build": 4}, "turn_start_resume_kind": "none", "process_turn_index": 0, "time_to_request_loop_lag_ms": 43, "time_to_request_cpu_ms": 123, "time_to_request_major_faults": 0, "process_rss_mib_turn_start": 209, "process_anon_mib_turn_start": 133, "process_rss_mib_result": 219, "process_anon_mib_result": 130, "process_peak_rss_mib": 234, "process_cpu_ms_turn": 1168, "process_wall_ms_turn": 23239, "process_cpu_ms_streaming": 548, "process_wall_ms_streaming": 13242, "main_stream_count": 4, "main_stream_event_count": 240, "main_stream_chunk_count": 66, "process_turn_states": {"main_stream": {"cpu_ms": 548, "wall_ms": 13242, "entries": 4}, "tool": {"cpu_ms": 64, "wall_ms": 449, "entries": 3}, "first_event_wait": {"cpu_ms": 329, "wall_ms": 7189, "entries": 4}, "before_first_request": {"cpu_ms": 122, "wall_ms": 93, "entries": 1}, "between_requests": {"cpu_ms": 72, "wall_ms": 85, "entries": 3}, "after_last_request": {"cpu_ms": 33, "wall_ms": 2181, "entries": 1}}, "tool_schema_build_detail": {"betas_ms": 0, "waits_ms": 1, "placement_ms": 1, "render_ms": 14, "after_ms": 0, "other_ms": 1, "tools": 17, "new_schemas": 17}, "message_normalization_detail": {"before_ms": 0, "normalize_ms": 2, "images_ms": 0, "post_process_ms": 0,